      <aliases enabled='yes' />
      <column caption='Total Sales' datatype='real' name='[Calculation_2275725234313326592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Net_Sales])' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_2275725234313523201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order_ID])' />
      </column>
      <column caption='Total Quantity Sold' datatype='integer' name='[Calculation_2275725234313691138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Quantity])' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_2275725234313891843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Net_Sales])/COUNTD([Order_ID])' />
      </column>
      <column caption='Average Customer Rating' datatype='real' name='[Calculation_2275725234314108932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Customer_Rating])' />
      </column>
      <column caption='Reorder Required' datatype='integer' name='[Calculation_2275725234314383365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF[Inventory_Available]&lt;=[Reorder_Level]&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Total Reorder Required' datatype='integer' name='[Calculation_2275725234315280390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2275725234314383365])' />
      </column>
      <column caption='Month Year' datatype='datetime' name='[Calculation_2275725234315636743]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[Order_Date])' />
      </column>
      <column caption='Sales Lakh' datatype='real' name='[Calculation_2275725234332397576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Net_Sales]) / 100000' />
      </column>
